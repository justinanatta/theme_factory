<section class="lp-hero">
  <div class="lp-hero__media">
    <img
      class="lp-hero__image"
      src="{{ 'lp-hero-bg.jpg' | asset_url }}"
      alt="Porsche 911 GT2 RS"
      loading="eager"
      fetchpriority="high"
      width="2000"
      height="1333"
    >
    <div class="lp-hero__overlay"></div>
  </div>

  <div class="lp-hero__content">
    <p class="lp-hero__eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 class="lp-hero__heading">{{ section.settings.heading }}</h1>
    <p class="lp-hero__subheading">{{ section.settings.subheading }}</p>
    <div class="lp-hero__ctas">
      <a href="{{ section.settings.cta_primary_url }}" class="lp-btn lp-btn--primary">
        {{ section.settings.cta_primary_label }}
      </a>
      <a href="{{ section.settings.cta_secondary_url }}" class="lp-btn lp-btn--outline">
        {{ section.settings.cta_secondary_label }}
      </a>
    </div>
  </div>

  <div class="lp-hero__scroll" aria-hidden="true">
    <div class="lp-hero__scroll-dot"></div>
  </div>
</section>

<style>
/* ─── Hero section ───────────────────────────────────────── */
.lp-hero {
  position: relative;
  width: 100%;
  height: 100svh;
  min-height: 520px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: var(--lp-black);
  color: var(--lp-white);
}

.lp-hero__media {
  position: absolute;
  inset: 0;
}
.lp-hero__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 40%;
  display: block;
}
.lp-hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    rgba(0,0,0,0.55) 0%,
    rgba(0,0,0,0.35) 45%,
    rgba(0,0,0,0.85) 100%
  );
}

.lp-hero__content {
  position: relative;
  z-index: 2;
  text-align: center;
  padding-inline: var(--lp-gutter);
  max-width: 860px;
  width: 100%;
}

.lp-hero__eyebrow {
  font-size: 0.6875rem;
  letter-spacing: 0.35em;
  color: var(--lp-red);
  text-transform: uppercase;
  margin: 0 0 1rem;
  font-weight: 600;
}
.lp-hero__heading {
  font-size: clamp(3.25rem, 10vw, 7.5rem);
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 0.95;
  margin: 0 0 1.25rem;
  color: var(--lp-white);
}
.lp-hero__subheading {
  font-size: clamp(1rem, 2.2vw, 1.375rem);
  color: var(--lp-gray-300);
  max-width: 38rem;
  margin: 0 auto 2.25rem;
  line-height: 1.6;
}
.lp-hero__ctas {
  display: flex;
  gap: 1rem;
  justify-content: center;
  flex-wrap: wrap;
}

/* ─── Scroll indicator ───────────────────────────────────── */
.lp-hero__scroll {
  position: absolute;
  bottom: 2rem;
  left: 50%;
  transform: translateX(-50%);
  width: 1.375rem;
  height: 2.25rem;
  border: 2px solid rgba(255,255,255,0.4);
  border-radius: 9999px;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 0.3rem;
  animation: lp-scroll-bounce 2s ease-in-out infinite;
}
.lp-hero__scroll-dot {
  width: 0.2rem;
  height: 0.45rem;
  background: rgba(255,255,255,0.5);
  border-radius: 9999px;
}
@keyframes lp-scroll-bounce {
  0%, 100% { transform: translateX(-50%) translateY(0); opacity: 1; }
  60% { transform: translateX(-50%) translateY(6px); opacity: 0.6; }
}

/* ─── Breakpoints ────────────────────────────────────────── */

/* Small phones (≤ 479px) */
@media screen and (max-width: 479px) {
  .lp-hero { min-height: 100svh; }
  .lp-hero__heading { letter-spacing: -0.01em; }
  .lp-hero__ctas { flex-direction: column; align-items: center; }
  .lp-btn { width: 100%; max-width: 280px; }
  .lp-hero__scroll { display: none; }
}

/* Phones (480px – 749px) */
@media screen and (min-width: 480px) and (max-width: 749px) {
  .lp-hero__image { object-position: 60% center; }
}

/* Tablets (750px – 1023px) */
@media screen and (min-width: 750px) and (max-width: 1023px) {
  .lp-hero__image { object-position: 55% center; }
}

/* Desktop (≥ 1024px) */
@media screen and (min-width: 1024px) {
  .lp-hero__subheading { font-size: 1.375rem; }
}

/* Large desktop (≥ 1400px) */
@media screen and (min-width: 1400px) {
  .lp-hero__heading { font-size: 8rem; }
}
</style>

{% schema %}
{
  "name": "LP — Hero",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "THE LEGEND RETURNS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "911 GT2 RS" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "The most powerful street-legal 911 ever built. Pure performance, uncompromising design." },
    { "type": "text", "id": "cta_primary_label", "label": "Primary CTA label", "default": "Book Test Drive" },
    { "type": "url", "id": "cta_primary_url", "label": "Primary CTA link" },
    { "type": "text", "id": "cta_secondary_label", "label": "Secondary CTA label", "default": "Explore Features" },
    { "type": "url", "id": "cta_secondary_url", "label": "Secondary CTA link" }
  ],
  "presets": [{ "name": "LP — Hero" }]
}
{% endschema %}
