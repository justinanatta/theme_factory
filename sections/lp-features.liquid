<section class="lp-features">
  <div class="lp-features__inner lp-page-width">
    <div class="lp-features__layout">
      <div class="lp-features__text">
        <h2 class="lp-features__heading">{{ section.settings.heading }}</h2>
        <div class="lp-features__body">{{ section.settings.body }}</div>
        {%- if section.blocks.size > 0 -%}
          <ul class="lp-features__list" role="list">
            {%- for block in section.blocks -%}
              <li class="lp-features__item" {{ block.shopify_attributes }}>
                <span class="lp-features__bullet" aria-hidden="true"></span>
                <div>
                  <div class="lp-features__item-title">{{ block.settings.title }}</div>
                  {%- if block.settings.description != blank -%}
                    <div class="lp-features__item-desc">{{ block.settings.description }}</div>
                  {%- endif -%}
                </div>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
      <div class="lp-features__media">
        <img
          class="lp-features__image"
          src="{{ 'lp-features-bg.jpg' | asset_url }}"
          alt="Porsche 911 GT2 RS — side profile"
          loading="lazy"
          width="900"
          height="600"
        >
      </div>
    </div>
  </div>
</section>

<style>
.lp-features {
  background: var(--lp-black);
  padding-block: clamp(3rem, 7vw, 5rem);
  color: var(--lp-white);
}
.lp-features__layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: clamp(2rem, 5vw, 4rem);
  align-items: center;
}
.lp-features__heading {
  font-size: clamp(1.875rem, 4vw, 3.125rem);
  font-weight: 700;
  color: var(--lp-white);
  margin: 0 0 1.25rem;
  line-height: 1.1;
}
.lp-features__body {
  color: var(--lp-zinc-400);
  font-size: clamp(0.9375rem, 1.5vw, 1.125rem);
  line-height: 1.75;
  margin-bottom: 2rem;
}
.lp-features__body p { margin: 0; }
.lp-features__list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}
.lp-features__item {
  display: flex;
  align-items: flex-start;
  gap: 0.875rem;
}
.lp-features__bullet {
  flex-shrink: 0;
  width: 6px;
  height: 6px;
  background: var(--lp-red);
  border-radius: 50%;
  margin-top: 0.45rem;
}
.lp-features__item-title {
  font-weight: 600;
  color: var(--lp-white);
  font-size: 0.9375rem;
  margin-bottom: 0.2rem;
}
.lp-features__item-desc {
  font-size: 0.875rem;
  color: var(--lp-zinc-500);
  line-height: 1.5;
}
.lp-features__image {
  width: 100%;
  height: auto;
  border-radius: 0.5rem;
  box-shadow: 0 30px 60px rgba(0,0,0,0.6);
  display: block;
  object-fit: cover;
}

/* ─── Breakpoints ─── */
/* Tablet portrait + mobile (≤ 749px): stack */
@media screen and (max-width: 749px) {
  .lp-features__layout {
    grid-template-columns: 1fr;
  }
  .lp-features__media {
    order: -1;
  }
  .lp-features__image {
    max-height: 320px;
    object-fit: cover;
    width: 100%;
  }
}
/* Small phones (≤ 479px) */
@media screen and (max-width: 479px) {
  .lp-features__image { max-height: 220px; border-radius: 0.375rem; }
}
/* Large desktop (≥ 1400px) */
@media screen and (min-width: 1400px) {
  .lp-features__layout { gap: 5rem; }
}
</style>

{% schema %}
{
  "name": "LP — Features",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Precision Engineering" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>The 911 GT2 RS features a 3.8-liter twin-turbocharged flat-six engine, delivering unprecedented power through rear-wheel drive. Every component is meticulously crafted for maximum performance.</p>" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Twin-Turbocharged Power" },
        { "type": "text", "id": "description", "label": "Description", "default": "Variable turbine geometry for instant response" }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP — Features",
      "blocks": [
        { "type": "feature", "settings": { "title": "Twin-Turbocharged Power", "description": "Variable turbine geometry for instant response" } },
        { "type": "feature", "settings": { "title": "7-Speed PDK Transmission", "description": "Lightning-fast gear changes" } },
        { "type": "feature", "settings": { "title": "Rear-Axle Steering", "description": "Enhanced agility and stability" } }
      ]
    }
  ]
}
{% endschema %}
