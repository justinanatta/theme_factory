<section class="lp-stats">
  <div class="lp-stats__inner lp-page-width">
    <div class="lp-stats__header">
      <h2 class="lp-stats__heading">{{ section.settings.heading }}</h2>
      <p class="lp-stats__subheading">{{ section.settings.subheading }}</p>
    </div>
    <div class="lp-stats__grid">
      {%- for block in section.blocks -%}
        <div class="lp-stats__card" {{ block.shopify_attributes }}>
          <div class="lp-stats__card-icon" aria-hidden="true">
            {{- block.settings.icon -}}
          </div>
          <div class="lp-stats__value">{{ block.settings.value }}</div>
          <div class="lp-stats__label">{{ block.settings.label }}</div>
          {%- if block.settings.sublabel != blank -%}
            <div class="lp-stats__sublabel">{{ block.settings.sublabel }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
.lp-stats {
  background: var(--lp-zinc-950);
  padding-block: clamp(3rem, 6vw, 5rem);
  color: var(--lp-white);
}
.lp-stats__header {
  text-align: center;
  margin-bottom: clamp(2rem, 4vw, 4rem);
}
.lp-stats__heading {
  font-size: clamp(1.875rem, 4vw, 3.125rem);
  font-weight: 700;
  color: var(--lp-white);
  margin: 0 0 0.75rem;
  line-height: 1.1;
}
.lp-stats__subheading {
  color: var(--lp-zinc-400);
  font-size: clamp(1rem, 1.5vw, 1.125rem);
  margin: 0;
}
.lp-stats__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: clamp(1rem, 2vw, 2rem);
}
.lp-stats__card {
  background: var(--lp-zinc-900);
  padding: clamp(1.25rem, 3vw, 2rem);
  border-radius: 0.5rem;
  border: 1px solid var(--lp-zinc-800);
  transition: border-color 0.25s ease, transform 0.25s ease;
}
.lp-stats__card:hover {
  border-color: var(--lp-red);
  transform: translateY(-2px);
}
.lp-stats__card-icon {
  color: var(--lp-red);
  margin-bottom: 1rem;
  line-height: 1;
}
.lp-stats__card-icon svg {
  width: 2.5rem;
  height: 2.5rem;
  display: block;
}
.lp-stats__value {
  font-size: clamp(1.75rem, 3vw, 2.5rem);
  font-weight: 700;
  color: var(--lp-white);
  margin-bottom: 0.375rem;
  line-height: 1;
}
.lp-stats__label {
  color: var(--lp-zinc-400);
  font-size: 0.9375rem;
}
.lp-stats__sublabel {
  color: var(--lp-zinc-500);
  font-size: 0.8125rem;
  margin-top: 0.375rem;
}

/* ─── Breakpoints ─── */
/* Tablet (≤ 749px): 2-col */
@media screen and (max-width: 749px) {
  .lp-stats__grid { grid-template-columns: repeat(2, 1fr); }
}
/* Small phones (≤ 479px): 1-col */
@media screen and (max-width: 479px) {
  .lp-stats__grid { grid-template-columns: 1fr; }
  .lp-stats__card { display: flex; align-items: center; gap: 1rem; }
  .lp-stats__card-icon { margin-bottom: 0; flex-shrink: 0; }
}
/* Large desktop (≥ 1400px) */
@media screen and (min-width: 1400px) {
  .lp-stats__grid { gap: 2.5rem; }
}
</style>

